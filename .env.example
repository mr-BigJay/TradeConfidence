# OpenAI official OR ArvanCloud AIaaS (text analysis)
OPENAI_API_KEY=
OPENAI_MODEL=GPT-4.1-Mini
# Full gateway URL from Arvan panel. Must end with /v1
OPENAI_BASE_URL=
OPENAI_AUTH_SCHEME=apikey
OPENAI_JSON_MODE=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily trading plan + setup chart at 03:30 Iran time (after daily candle close)
DAILY_SETUP_CRON=30 3 * * *
# 8-hour scenario progress reports (default 11:30 and 19:30 Iran)
SCENARIO_CHECK_ENABLED=true
SCENARIO_CHECK_CRON=30 11,19 * * *
# Intraday updates are OFF by default. Set true only if you want hourly checks.
INTRADAY_ENABLED=false
CHECK_INTERVAL_MINUTES=60

SCRAPE_TIMEOUT_MS=45000
# CoinEx futures page (AI Research lives here)
# https://www.coinex.com/en/futures/btc-usdt
COINEX_SYMBOLS=BTCUSDT
HEADLESS=true

# Market data sources
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_DATA_BASE=https://fapi.binance.com
BINANCE_WS_ENABLED=false
DERIBIT_BASE_URL=https://www.deribit.com/api/v2/public

# Card images are always rendered on the server (HTML → PNG).
CARD_MODE=html
CARD_SCALE=2

DATABASE_PATH=./data/coinex-ai-bot.sqlite
LOG_LEVEL=info
