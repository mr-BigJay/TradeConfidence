# OpenAI official OR ArvanCloud AIaaS (text analysis)
OPENAI_API_KEY=
OPENAI_MODEL=GPT-4.1-Mini
# Full gateway URL from Arvan panel. Must end with /v1 (no truncation, no trailing >)
OPENAI_BASE_URL=
OPENAI_AUTH_SCHEME=apikey
OPENAI_JSON_MODE=false

# Optional: only needed when CARD_MODE=api
# Create a separate IMAGE model endpoint in Arvan and paste its full gateway /v1 URL.
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=Gemini-3-Pro-Image-Preview
IMAGE_AUTH_SCHEME=apikey
IMAGE_SIZE=1792x1024
IMAGE_QUALITY=hd

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CHECK_INTERVAL_MINUTES=30
COINEX_SYMBOLS=BTCUSDT
HEADLESS=true
SCRAPE_TIMEOUT_MS=30000
# html = render card on server (recommended). api = Arvan image model.
CARD_MODE=html
CARD_SCALE=2
DATABASE_PATH=./data/coinex-ai-bot.sqlite
LOG_LEVEL=info
